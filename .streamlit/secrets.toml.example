# Template for Streamlit secrets.
#
# Local dev: copy this file to .streamlit/secrets.toml and fill in the
# values. The real secrets.toml is gitignored so credentials never get
# committed.
#
# Production (Streamlit Cloud): you don't need this file in the repo.
# Paste the same key/value into Streamlit Cloud:
#   App → ... menu → Settings → Secrets → paste the TOML → Save.

# The full Postgres connection string from Neon. Format:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Copy this exactly from the Neon dashboard (Project → Connection Details).
DATABASE_URL = "postgresql://your_user:your_password@your-neon-host.neon.tech/your_db?sslmode=require"
